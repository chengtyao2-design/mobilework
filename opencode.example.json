{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/qwen/qwen3.8-flash",
  "small_model": "openrouter/qwen/qwen3.7-flash",
  "enabled_providers": ["openrouter"],
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 16000
  },
  "mcp": {
    "wiki-retrieval": {
      "type": "local",
      "command": ["{env:MOBILEWORK_PYTHON}", "-m", "wiki_retrieval.server"],
      "enabled": true,
      "environment": {
        "WIKI_RETRIEVAL_PROJECT": "{env:MOBILEWORK_ROOT}"
      }
    }
  }
}
