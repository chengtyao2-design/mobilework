__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Node.js 依赖缓存与包管理器调试日志
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS
.DS_Store

# 引擎运行态与可恢复回收站，由 wiki_maintainer 写入
.wiki-state/
.wiki-trash/
.mobilework-state/
.mobilework-state/logs/
kb/*/.wiki-state/
kb/*/.wiki-trash/

# 向量库落盘目录
.lancedb/
kb/*/.lancedb/

# 本地 embedding 权重（由 setup/probe 下载，不提交二进制模型）
.mobilework-models/

# 本地配置，从 *.example 复制
.env
opencode.json

# 解析组到位前的临时解析脚本与台账，以及抽取产出的 md 源文件
# （正式解析流水线上线后这两条由解析组规范替代；.gitkeep 与 extract.py 占位不在此列）
parsing/local_extract.py
parsing/manifests/*.md
!parsing/manifests/.gitkeep
!parsing/manifests/kb_enterprise.md
!parsing/manifests/kb_research.md
parsing/resource/kb_research/
kb/*/raw/sources/*.md
!kb/*/raw/sources/.gitkeep
!kb/kb_research/raw/sources/*.md

# 开发期依据当前 raw/sources 构建出的 wiki 页面（编译产物），保留占位 .gitkeep
kb/*/wiki/**/*.md
!kb/*/wiki/**/.gitkeep

# 检索评测每轮的运行产物（合成语料、jsonl、stderr 转储），体积大且可由 harness 复现
benchmarks/retrieval_eval/artifacts/

# 临时工作区、导出文件与 Office 锁文件
tmp/
output/
~$*
*.tmp
*.temp
*.bak

# 本地工具、测试与覆盖率缓存
.opencode/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Python 打包与通用构建产物
build/
dist/

# 本地编辑器与操作系统元数据
.idea/
.vscode/
Thumbs.db
Desktop.ini

# 报告/演示文稿的中间网页，可由源文件重新生成
docs/LLM_WIKI_RETRIEVAL_TECHNICAL_REPORT.html
docs/report-deck-optimized.html
