# 复制为 .env 后填写。项目根由 wiki_retrieval.server 向上查找定位，留 "." 即可，不写绝对路径。
WIKI_RETRIEVAL_PROJECT=.

# 向量化服务。local 使用项目内忽略提交的轻量 ONNX 模型；openrouter 保留远程兼容。
EMBEDDING_PROVIDER=local
EMBEDDING_LOCAL_MODEL_PATH=.mobilework-models/bge-small-zh-v1.5
EMBEDDING_LOCAL_VARIANT=onnx/model_quantized.onnx
EMBEDDING_LOCAL_THREADS=8
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
