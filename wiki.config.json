{
  "sources_dir": "raw/sources",
  "wiki_dir": "wiki",
  "state_dir": ".wiki-state",
  "trash_dir": ".wiki-trash",
  "language": "zh-CN",
  "semantic_revision": 2,
  "include_extensions": [
    ".md",
    ".markdown",
    ".txt"
  ],
  "ignore_names": [
    ".DS_Store",
    "Thumbs.db"
  ],
  "watch": {
    "interval_seconds": 2.0,
    "settle_seconds": 1.0,
    "retry_seconds": 30.0,
    "agent_command": [
      "opencode",
      "run",
      "--format",
      "json",
      "--dir",
      "{root}",
      "{prompt}"
    ]
  }
}
